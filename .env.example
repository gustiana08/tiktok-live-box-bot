# === Telegram Configuration ===
# Bot token dari @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID tujuan notifikasi (channel/group/user)
# Untuk mendapatkan chat ID: kirim pesan ke bot, lalu buka
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# === TikTok Configuration ===
# Daftar username TikTok yang mau dimonitor (pisahkan dengan koma)
# Kosongkan jika ingin pakai auto-discovery trending lives
TIKTOK_USERNAMES=

# Interval scan dalam detik (default: 30)
SCAN_INTERVAL=30

# Jumlah maksimal live stream yang dimonitor bersamaan
MAX_CONCURRENT_STREAMS=10

# === Notification Settings ===
# Kirim notifikasi saat bot mulai/stop
NOTIFY_ON_START=true

# Cooldown notifikasi per stream dalam detik (hindari spam)
NOTIFICATION_COOLDOWN=300

# === Logging ===
LOG_LEVEL=INFO
